{
  "name": "@ecojotaduo/tenancy",
  "version": "0.1.0",
  "private": true,
  "description": "Módulo de tenancy: organizações, tenants, vínculos, papéis e contratação de módulos",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@ecojotaduo/audit": "workspace:*",
    "@ecojotaduo/database": "workspace:*",
    "@ecojotaduo/identity": "workspace:*",
    "@ecojotaduo/permissions": "workspace:*",
    "@ecojotaduo/platform-kernel": "workspace:*",
    "@ecojotaduo/tenant-context": "workspace:*",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@ecojotaduo/eslint-config": "workspace:*",
    "@ecojotaduo/test-support": "workspace:*",
    "@ecojotaduo/tsconfig": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "^10.8.1",
    "postgres": "^3.4.9",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
