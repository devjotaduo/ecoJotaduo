# Copie para .env e ajuste. O boot falha cedo se algo estiver inválido
# (schema em packages/config).

NODE_ENV=development
PORT=3000
# Gateway MCP: processo separado da API (ADR-0004), porta separada.
MCP_PORT=3001

# Conexão da APLICAÇÃO: papel restrito, sem privilégio de dono. É sobre ele
# que a Row Level Security atua — não use aqui o usuário dono das tabelas.
DATABASE_URL=postgresql://ecojotaduo_app:ecojotaduo_app@127.0.0.1:5432/ecojotaduo

# Conexão do DONO das tabelas: usada apenas por `pnpm migrate` e `seed:dev`.
DATABASE_ADMIN_URL=postgresql://ecojotaduo:ecojotaduo@127.0.0.1:5432/ecojotaduo
DATABASE_APP_ROLE=ecojotaduo_app

# Assinatura dos access tokens (mínimo 32 bytes). Em produção, gere um valor
# aleatório e guarde no gerenciador de segredos — nunca versione.
JWT_SECRET=troque-este-segredo-de-desenvolvimento-agora
JWT_ISSUER=ecojotaduo-platform
JWT_AUDIENCE=ecojotaduo-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Cifra os segredos de integracao guardados por empresa (32 bytes em base64).
# Gere o seu e NUNCA versione:  openssl rand -base64 32
SECRETS_KEY=

# Limite de requisicoes (Fase 10). O contador vive na memoria do processo:
# com N replicas o teto efetivo e N vezes maior.
RATE_LIMIT_WINDOW_SECONDS=60
# Teto por credencial nas rotas autenticadas.
RATE_LIMIT_MAX=300
# Teto do login por origem — apertado de proposito (forca bruta).
RATE_LIMIT_LOGIN_MAX=10
# Teto por credencial no gateway MCP (agente em laco).
RATE_LIMIT_MCP_MAX=120
