{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/verifica-migracao.mjs"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/verifica-injecao-nest.mjs"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm format:check)",
      "Bash(pnpm --filter *:*)",
      "Bash(docker compose -f docker/docker-compose.yml ps:*)",
      "Bash(docker compose -f docker/docker-compose.yml up -d:*)",
      "Bash(docker compose -f docker/docker-compose.yml logs:*)"
    ]
  }
}
