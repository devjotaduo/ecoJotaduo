{
  "name": "@ecojotaduo/api",
  "version": "0.0.0",
  "private": true,
  "description": "API REST da plataforma (NestJS + Fastify + OpenAPI)",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "dev": "tsc -p tsconfig.build.json && node --env-file-if-exists=../../.env --enable-source-maps dist/main.js",
    "start": "node --enable-source-maps dist/main.js",
    "migrate": "tsc -p tsconfig.build.json && node --env-file-if-exists=../../.env dist/cli/migrate.js",
    "seed:dev": "tsc -p tsconfig.build.json && node --env-file-if-exists=../../.env dist/cli/seed-dev.js",
    "openapi": "tsc -p tsconfig.build.json && node --env-file-if-exists=../../.env dist/cli/emit-openapi.js"
  },
  "dependencies": {
    "@ecojotaduo/audit": "workspace:*",
    "@ecojotaduo/auth": "workspace:*",
    "@ecojotaduo/config": "workspace:*",
    "@ecojotaduo/crm": "workspace:*",
    "@ecojotaduo/database": "workspace:*",
    "@ecojotaduo/http-kit": "workspace:*",
    "@ecojotaduo/identity": "workspace:*",
    "@ecojotaduo/permissions": "workspace:*",
    "@ecojotaduo/platform-core": "workspace:*",
    "@ecojotaduo/platform-kernel": "workspace:*",
    "@ecojotaduo/plugin-notifications-example": "workspace:*",
    "@ecojotaduo/plugin-sdk": "workspace:*",
    "@ecojotaduo/plugins": "workspace:*",
    "@ecojotaduo/tenancy": "workspace:*",
    "@ecojotaduo/tenant-context": "workspace:*",
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-fastify": "^11.2.1",
    "@nestjs/swagger": "^11.4.7",
    "fastify": "^5.12.1",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ecojotaduo/api-client": "workspace:*",
    "@ecojotaduo/eslint-config": "workspace:*",
    "@ecojotaduo/test-support": "workspace:*",
    "@ecojotaduo/tsconfig": "workspace:*",
    "@nestjs/testing": "^11.2.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.8.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
