{
  "name": "@ecojotaduo/mcp-gateway",
  "version": "0.0.0",
  "private": true,
  "description": "Gateway MCP: expoe as capacidades dos modulos a agentes via Streamable HTTP",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "dev": "tsc -p tsconfig.build.json && node --env-file-if-exists=../../.env --enable-source-maps dist/main.js",
    "start": "node --enable-source-maps dist/main.js"
  },
  "dependencies": {
    "@ecojotaduo/audit": "workspace:*",
    "@ecojotaduo/auth": "workspace:*",
    "@ecojotaduo/config": "workspace:*",
    "@ecojotaduo/database": "workspace:*",
    "@ecojotaduo/mcp-kit": "workspace:*",
    "@ecojotaduo/permissions": "workspace:*",
    "@ecojotaduo/platform-core": "workspace:*",
    "@ecojotaduo/platform-kernel": "workspace:*",
    "@ecojotaduo/tenancy": "workspace:*",
    "@ecojotaduo/tenant-context": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "fastify": "^5.12.1",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ecojotaduo/crm": "workspace:*",
    "@ecojotaduo/eslint-config": "workspace:*",
    "@ecojotaduo/test-support": "workspace:*",
    "@ecojotaduo/tsconfig": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "^10.8.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
