{
  "name": "@ecojotaduo/web",
  "version": "0.0.0",
  "private": true,
  "description": "Aplicacao web da plataforma: CRM, propostas e contratos sobre o SDK gerado",
  "type": "module",
  "scripts": {
    "dev": "vite",
