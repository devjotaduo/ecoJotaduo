# Copie para .env.test (fora do git) para habilitar os testes de integração.
# Sem estas variáveis, as suítes que precisam de banco se declaram PULADAS.
#
# Suba a infraestrutura antes:
#   cp docker/.env.example docker/.env
#   docker compose -f docker/docker-compose.yml up -d

# O banco apontado aqui é o de MANUTENÇÃO: cada pacote cria e usa o seu
# (`ecojotaduo_test_<pacote>`), para as suítes não disputarem a mesma base.
#
# Conexão da aplicação: papel restrito, é sobre ele que a RLS atua.
TEST_DATABASE_URL=postgresql://ecojotaduo_app:ecojotaduo_app@127.0.0.1:5432/ecojotaduo_test

# Conexão do dono das tabelas: roda migrações e semeia dados nos testes.
TEST_ADMIN_DATABASE_URL=postgresql://ecojotaduo:ecojotaduo@127.0.0.1:5432/ecojotaduo_test
