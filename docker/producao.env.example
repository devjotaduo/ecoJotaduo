# Modelo do ambiente de producao. Copie e preencha:
#
#   cp docker/producao.env.example docker/.env.prod
#   docker compose -f docker/docker-compose.prod.yml --env-file docker/.env.prod up -d --build
#
# O arquivo preenchido NUNCA e versionado (`.gitignore` cobre `.env*`).
#
# Os valores marcados com "gere" precisam ser aleatorios e unicos por ambiente.
# Reaproveitar o de outro ambiente significa que quem tem acesso a um tem
# acesso ao outro.

# --- Dominio ---------------------------------------------------------------
# Endereco publico da aplicacao. O Caddy emite o certificado a partir daqui.
# Tela, API e gateway MCP ficam TODOS neste dominio: o cookie de sessao e
# SameSite=Strict e nao atravessaria dominios diferentes (ADR-0011).
SITE_ADDRESS=https://app.exemplo.com
ACME_EMAIL=operacao@exemplo.com

# Para experimentar localmente sem DNS publico, use certificado local:
#   SITE_ADDRESS=https://localhost
#   CADDY_EXTRA_GLOBAL=local_certs
CADDY_EXTRA_GLOBAL=

# --- Banco -----------------------------------------------------------------
# Dono das tabelas. Usado SO pelo servico `migrate`.
POSTGRES_USER=ecojotaduo
POSTGRES_PASSWORD=gere-uma-senha-longa-aqui
POSTGRES_DB=ecojotaduo

# Papel restrito da aplicacao. E sobre ele que a Row Level Security atua — se a
# aplicacao conectar como dono, o isolamento entre empresas para de valer.
APP_DB_USER=ecojotaduo_app
APP_DB_PASSWORD=gere-outra-senha-longa-aqui

# --- Segredos --------------------------------------------------------------
# Assinatura dos access tokens. Minimo 32 caracteres; gere aleatorio.
JWT_SECRET=gere-com-openssl-rand-base64-48
JWT_ISSUER=ecojotaduo-platform
JWT_AUDIENCE=ecojotaduo-api

# Cifra os segredos de integracao guardados por empresa (AES-256-GCM).
# EXATAMENTE 32 bytes em base64:  openssl rand -base64 32
# Perder esta chave torna ilegiveis todos os segredos ja gravados, e nao ha
# rotacao implementada — guarde no gerenciador de segredos, nao so aqui.
SECRETS_KEY=

# --- Sessao ----------------------------------------------------------------
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# --- Limites ---------------------------------------------------------------
# O contador vive na memoria de CADA processo. Com N replicas o teto efetivo e
# N vezes maior: divida o teto pretendido pelo numero de replicas.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=300
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_MCP_MAX=120

# --- Versao ----------------------------------------------------------------
# Tag das imagens. Em producao, aponte para um tag imutavel (o SHA do commit),
# nunca `latest` — senao "reiniciar" pode trocar a versao sem ninguem pedir.
TAG=latest
