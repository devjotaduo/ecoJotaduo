# Ambiente do job de imagens do CI. Versionado de proposito: nao ha segredo
# aqui — sao valores descartaveis, de uma pilha que sobe, responde e e
# destruida na mesma execucao.
#
# NUNCA use estes valores em ambiente de verdade. O modelo de producao e
# `docker/producao.env.example`.

SITE_ADDRESS=http://localhost
ACME_EMAIL=ci@localhost
CADDY_EXTRA_GLOBAL=

POSTGRES_USER=ecojotaduo
POSTGRES_PASSWORD=descartavel-do-ci-nao-use-em-lugar-nenhum
POSTGRES_DB=ecojotaduo
APP_DB_USER=ecojotaduo_app
APP_DB_PASSWORD=descartavel-do-ci-tambem

JWT_SECRET=valor-descartavel-do-ci-com-mais-de-32-caracteres
JWT_ISSUER=ecojotaduo-platform
JWT_AUDIENCE=ecojotaduo-api

# 32 bytes em base64 (todos iguais a 7): descartavel, so para o boot passar.
SECRETS_KEY=BwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwc=

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=300
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_MCP_MAX=120

TAG=ci
