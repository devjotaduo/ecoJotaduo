# Copie para docker/.env — valores de desenvolvimento local, nunca de produção.

# Dono das tabelas (roda migrações). Superusuário: a RLS não se aplica a ele.
POSTGRES_USER=ecojotaduo
POSTGRES_PASSWORD=ecojotaduo
POSTGRES_DB=ecojotaduo

# Papel usado pela aplicação. Sem privilégio de dono — é ele quem sofre a RLS.
APP_DB_USER=ecojotaduo_app
APP_DB_PASSWORD=ecojotaduo_app

# Banco usado pelos testes de integração.
TEST_DB_NAME=ecojotaduo_test
