{
  "name": "@ecojotaduo/platform-core",
  "version": "0.0.0",
  "private": true,
  "description": "Montagem unica dos modulos de dominio, compartilhada por todos os composition roots (api, mcp-gateway, worker)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@ecojotaduo/assets": "workspace:*",
    "@ecojotaduo/audit": "workspace:*",
    "@ecojotaduo/auth": "workspace:*",
    "@ecojotaduo/commercial": "workspace:*",
    "@ecojotaduo/config": "workspace:*",
    "@ecojotaduo/contracts": "workspace:*",
    "@ecojotaduo/crm": "workspace:*",
    "@ecojotaduo/database": "workspace:*",
    "@ecojotaduo/events": "workspace:*",
    "@ecojotaduo/identity": "workspace:*",
    "@ecojotaduo/mcp-kit": "workspace:*",
    "@ecojotaduo/operations": "workspace:*",
    "@ecojotaduo/permissions": "workspace:*",
    "@ecojotaduo/platform-kernel": "workspace:*",
    "@ecojotaduo/plugin-notifications-example": "workspace:*",
    "@ecojotaduo/plugin-sdk": "workspace:*",
    "@ecojotaduo/plugins": "workspace:*",
    "@ecojotaduo/tenancy": "workspace:*"
  },
  "devDependencies": {
    "@ecojotaduo/eslint-config": "workspace:*",
    "@ecojotaduo/tsconfig": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "^10.8.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
