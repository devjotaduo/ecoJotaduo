{
  "name": "@ecojotaduo/events",
  "version": "0.0.0",
  "private": true,
  "description": "Outbox transacional, contrato de eventos de integracao e dispatcher com retry e DLQ",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./drizzle": {
      "types": "./dist/drizzle.d.ts",
      "default": "./dist/drizzle.js"
    },
    "./dispatcher": {
      "types": "./dist/dispatcher.d.ts",
      "default": "./dist/dispatcher.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@ecojotaduo/database": "workspace:*",
    "@ecojotaduo/tenant-context": "workspace:*",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@ecojotaduo/eslint-config": "workspace:*",
    "@ecojotaduo/test-support": "workspace:*",
    "@ecojotaduo/tsconfig": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "^10.8.1",
    "postgres": "^3.4.9",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
